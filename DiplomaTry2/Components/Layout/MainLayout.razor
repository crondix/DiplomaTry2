@inherits LayoutComponentBase

<main class="app-shell">
    <nav class="app-shell__navigation" aria-label="Возврат к главному меню">
        <NavLink class="app-shell__home" href="" Match="NavLinkMatch.All">← Главное меню</NavLink>
    </nav>
    <article class="app-shell__content">
        @Body
    </article>
</main>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
