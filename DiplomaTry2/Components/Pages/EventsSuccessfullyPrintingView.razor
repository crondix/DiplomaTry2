@page "/Events"
@rendermode RenderMode.InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using DiplomaTry2.Components.Layout

<PageTitle>События сервера печати</PageTitle>

<section class="events-page" aria-labelledby="events-title">
    <nav class="events-page__rail" aria-label="Действия страницы событий">
        <a class="events-page__tile" href="/">
            <img src="images/events/arrow.png" alt="" />
            <span>Главное меню</span>
        </a>
        <button class="events-page__tile" type="button" @onclick='() => ShowNavigationNotice("Справка пока не реализована.")'>
            <img src="images/events/help.png" alt="" />
            <span>Справка</span>
        </button>
        <button class="events-page__tile" type="button" @onclick='() => ShowNavigationNotice("Настройки пока не реализованы.")'>
            <img src="images/events/settings.png" alt="" />
            <span>Настройки</span>
        </button>
    </nav>

    <div class="events-page__main">
        <div class="events-page__heading">
            <h1 id="events-title">События сервера печати</h1>
            <p>Последние 50 сохранённых событий. Импорт читает выбранный источник.</p>
        </div>

        <PrintSourceSwitcher />

        <div class="events-page__actions">
            <button class="btn btn-outline-primary" @onclick="LoadData" disabled="@(Loading || Adding)">@(Loading ? "Чтение…" : "Обновить таблицу")</button>
            <button class="btn btn-primary" @onclick="Actualization" disabled="@(Loading || Adding)">@(Adding ? "Импорт…" : "Импортировать события")</button>
        </div>

        @if (NavigationNotice is not null)
        {
            <p class="events-page__notice" role="status">@NavigationNotice</p>
        }
        @if (Adding)
        {
            <p role="status">Импорт выполняется. Обработано: @_currentItem.</p>
        }
        @if (ImportSummary is not null)
        {
            <p class="alert alert-success" role="status">@ImportSummary</p>
        }
        @if (AdditionErrorMessage is not null)
        {
            <p class="alert alert-danger" role="alert">@AdditionErrorMessage</p>
        }

        @if (Loading)
        {
            <p role="status">Чтение сохранённых событий…</p>
        }
        else if (EventsSuccessfulPrinting.Count == 0)
        {
            <p class="events-page__empty">Сохранённых событий пока нет.</p>
        }
        @if (EventsSuccessfulPrinting.Count > 0)
        {
            <div class="events-page__table-wrap">
                <PersistentGrid TableKey="print-events" Label="События сервера печати"
                                Items="EventsSuccessfulPrinting" Columns="EventColumns" RowSelector="EventRow" />
            </div>
        }
    </div>

    <aside class="events-page__rail events-page__rail--right" aria-label="Дополнительные действия">
        <button class="events-page__tile" type="button" @onclick='() => ShowNavigationNotice("Анализ загруженности пока не реализован.")'>
            <img src="images/events/analysis.png" alt="" />
            <span>Перейти к анализу</span>
        </button>
    </aside>
</section>

@code {
    private static readonly GridColumn[] EventColumns = [
        new("Время", "Time", DisplayFormat: "dd.MM.yyyy HH:mm:ss"), new("Отправитель", "Sender"), new("Компьютер", "Computer"),
        new("Принтер", "Printer", WidthGrow: 2), new("Документ", "Document", WidthGrow: 2),
        new("Страниц", "Pages"), new("Байт", "Size")
    ];

    private static EventGridRow EventRow(DiplomaModels.EventSuccessfulPrinting item, int index) =>
        new(item.DateTime, item.Sender?.Name ?? "—", item.SenderDevice?.NameNormalized ?? "—",
            item.TargetPrinter?.NetworkPrinter?.Name ?? item.TargetPrinter?.Name ?? "—",
            item.SentPrintingFile?.Name?.name ?? "—", item.SentPrintingFile?.Pages, item.SentPrintingFile?.Size);
}
