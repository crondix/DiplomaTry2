@page "/NetworkPrintersList"
@rendermode RenderMode.InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using DiplomaTry2.Components.Layout

<PageTitle>Сетевые принтеры</PageTitle>
<PrintDataFrame Title="Сетевые принтеры" Description="Этот список читается из источника и не сохраняется в базе данных." ShowEditAction="true" SourceSettings="true">
<button class="btn btn-primary mb-3" @onclick="LoadingData" disabled="@Loading">@(Loading ? "Загрузка…" : "Получить принтеры")</button>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="alert alert-danger" role="alert">@message</p>
}
@if (Loading)
{
    <p role="status">Получение принтеров…</p>
}
else if (printers is null)
{
    <p>Нажмите «Получить принтеры» для чтения выбранного источника.</p>
}
else if (printers.Count == 0)
{
    <p>Источник не вернул принтеров.</p>
}
@if (printers is { Count: > 0 })
{
    <div class="print-data-frame__table-wrap">
        <PersistentGrid TableKey="network-printers" Label="Сетевые принтеры"
                        Items="printers" Columns="PrinterColumns" RowSelector="PrinterRow" />
    </div>
}
</PrintDataFrame>

@code {
    private static readonly GridColumn[] PrinterColumns = [
        new("№", "Number"), new("Очередь", "Name", WidthGrow: 2, Visible: false),
        new("Общее имя", "ShareName"), new("Комментарий", "Comment", WidthGrow: 2),
        new("Порт / IP", "Port"), new("Драйвер", "Model", WidthGrow: 2), new("Доступен", "Online")
    ];

    private static PrinterGridRow PrinterRow(DiplomaModels.NetworkPrinter item, int index) =>
        new(index + 1, item.SourceKey, item.Name, item.ShareName, item.Comment, item.Ip ?? item.NonIPAddress,
            item.DriverName ?? "—", item.IsOnline ? "Да" : "Нет");
}
