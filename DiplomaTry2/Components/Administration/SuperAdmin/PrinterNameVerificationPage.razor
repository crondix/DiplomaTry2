@page "/PrinterNameVerification"
@rendermode RenderMode.InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using DiplomaModels
@using DiplomaTry2.Components.Layout
@implements IDisposable
@inject PrinterModelService ModelService
@inject IPrinterSource PrinterSource
@inject PrintSourceSelection Selection
@inject ILogger<PrinterNameVerificationPage> Logger

<PageTitle>Модели принтеров</PageTitle>
<PrintDataFrame Title="Модели принтеров" Description="Справочник реальных моделей и их характеристик.">
    <AuthorizeView Roles="Admin">
        <Authorized>
            <PrintSourceSwitcher />
            <div class="model-actions">
                <button class="btn btn-primary" disabled="@(busy || !modelsReady)" @onclick="AddModel">Добавить модель</button>
                <button class="btn btn-outline-primary" disabled="@busy" @onclick="FetchDriversAsync">Получить названия с сервера печати</button>
            </div>
        </Authorized>
    </AuthorizeView>
    @if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
    @if (message is not null) { <p class="alert alert-success" role="status">@message</p> }
    @if (busy) { <p role="status">Выполняется операция…</p> }
    <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => RunAsync(ReloadAsync)">Обновить список</button>
    @if (draft is not null)
    {
        <section class="model-panel" aria-labelledby="model-editor-title">
            <h2 id="model-editor-title">@(draft.Id == 0 ? "Добавление модели" : "Редактирование модели")</h2>
            <EditForm Model="draft" OnValidSubmit="SaveModelAsync" FormName="printer-model-edit">
                <DataAnnotationsValidator /><ValidationSummary />
                <fieldset disabled="@busy">
                    <label for="model-name">Название модели</label>
                    <InputText id="model-name" class="form-control" @bind-Value="draft.Name" />
                    <div class="model-fields">
                        <div><label for="model-color">Цветная печать</label>
                            <InputSelect id="model-color" class="form-select" @bind-Value="draft.IsColor">
                                <option value="">Не указано</option><option value="true">Да</option><option value="false">Нет</option>
                            </InputSelect>
                        </div>
                        <div><label for="model-duplex">Двусторонняя печать</label>
                            <InputSelect id="model-duplex" class="form-select" @bind-Value="draft.IsDuplexing">
                                <option value="">Не указано</option><option value="true">Да</option><option value="false">Нет</option>
                            </InputSelect>
                        </div>
                        <div><label for="model-copies">Максимум копий за печать</label>
                            <InputNumber id="model-copies" class="form-control" min="1" max="32767" @bind-Value="draft.MaxCopyPerPrint" />
                        </div>
                    </div>
                    <div class="model-actions">
                        <button type="submit" class="btn btn-primary">Сохранить</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => draft = null">Отмена</button>
                    </div>
                </fieldset>
            </EditForm>
        </section>
    }
    @if (deleteModel is not null)
    {
        <section class="model-panel" role="alertdialog" aria-labelledby="delete-title" aria-describedby="delete-description">
            <h2 id="delete-title">Подтверждение удаления</h2>
            <p id="delete-description">Удалить модель «@deleteModel.ModelName»? Принтеров с этой моделью: @linkedPrinters.
                Принтеры сохранятся, их привязка к модели будет очищена.</p>
            <div class="model-actions">
                <button class="btn btn-danger" disabled="@busy" @onclick="DeleteModelAsync">Удалить модель</button>
                <button class="btn btn-outline-secondary" disabled="@busy" @onclick="() => deleteModel = null">Отмена</button>
            </div>
        </section>
    }
    @if (showDrivers)
    {
        <section class="model-panel" aria-labelledby="driver-title">
            <h2 id="driver-title">Создание моделей из названий драйверов</h2>
            <p>Перенесите подходящие названия вправо. Универсальные драйверы оставьте слева. Модели создаются только после нажатия «Добавить выбранные модели».</p>
            <fieldset disabled="@busy">
                <div class="driver-lists">
                    <section aria-labelledby="available-drivers-title">
                        <h3 id="available-drivers-title">Названия драйверов (@available.Count)</h3>
                        <DxListBox TData="string" TValue="string" Data="available" SelectionMode="ListBoxSelectionMode.Multiple"
                                   ShowCheckboxes="true" ShowSelectAllCheckbox="true" @bind-Values="leftSelection" CssClass="driver-list" />
                    </section>
                    <div class="driver-transfer">
                        <button class="btn btn-outline-primary" disabled="@(busy || !leftSelection.Any())" @onclick="MoveRight">Выбрать →</button>
                        <button class="btn btn-outline-secondary" disabled="@(busy || !rightSelection.Any())" @onclick="MoveLeft">← Вернуть</button>
                    </div>
                    <section aria-labelledby="chosen-drivers-title">
                        <h3 id="chosen-drivers-title">Выбрано для создания моделей (@chosen.Count)</h3>
                        <DxListBox TData="string" TValue="string" Data="chosen" SelectionMode="ListBoxSelectionMode.Multiple"
                                   ShowCheckboxes="true" ShowSelectAllCheckbox="true" Values="rightSelection" ValuesChanged="RightSelectionChanged" CssClass="driver-list" />
                    </section>
                </div>
                @if (rightSelection.Count() == 1)
                {
                    <label for="selected-model-name">Исправить название выбранной модели</label>
                    <div class="model-actions">
                        <input id="selected-model-name" class="form-control" @bind="renamedName" />
                        <button class="btn btn-outline-primary" @onclick="RenameSelected">Применить название</button>
                    </div>
                }
                <div class="model-actions">
                    <button class="btn btn-primary" disabled="@(busy || chosen.Count == 0)" @onclick="SaveSelectedAsync">Добавить выбранные модели</button>
                    <button class="btn btn-outline-secondary" disabled="@busy" @onclick="CloseDrivers">Закрыть</button>
                </div>
            </fieldset>
        </section>
    }
    @if (!busy && models.Count == 0) { <p>Сохранённых моделей пока нет.</p> }
    <div class="print-data-frame__table-wrap">
        <PersistentGrid TableKey="printer-models" Label="Модели принтеров" Items="models" Columns="ModelColumns" RowSelector="ModelRow">
            <RowActions Context="row">
                <AuthorizeView Roles="Admin" Context="modelAuthorization">
                    <button class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => EditModel(row.Id)">Редактировать</button>
                    <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => ConfirmDeleteAsync(row.Id)">Удалить</button>
                </AuthorizeView>
            </RowActions>
        </PersistentGrid>
    </div>
</PrintDataFrame>
